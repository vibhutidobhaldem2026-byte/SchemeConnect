# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Resend (https://resend.com) — delivers email OTP codes.
# Create a key at https://resend.com/api-keys. A "Sending access" key is enough.
RESEND_API_KEY=

# Sender address, on a domain you have VERIFIED at https://resend.com/domains.
# Adding a domain is not enough — Resend rejects sends from it until its DNS
# records are added and verification passes.
RESEND_FROM=SchemeConnect <no-reply@yourdomain.com>

# Where replies to transactional mail should go.
RESEND_REPLY_TO=support@yourdomain.com

# Used only if RESEND_FROM's domain is not verified yet, so sign-in keeps
# working during DNS propagation. Resend sandbox limits apply while it is in
# use (delivery only to the Resend account owner's own address).
RESEND_FROM_FALLBACK=SchemeConnect <onboarding@resend.dev>

# Show the OTP on screen even when it was emailed successfully.
# Handy while testing; set to false before any real pilot.
SHOW_DEV_OTP=false

PORT=3000

# Bind address. 0.0.0.0 makes the site reachable from other devices on the
# same network (e.g. a phone). Set to 127.0.0.1 to keep it local-only.
HOST=0.0.0.0
