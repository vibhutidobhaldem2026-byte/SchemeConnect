{
  "name": "schemeconnect-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SchemeConnect backend — server-rendered app, eligibility engine, and the government-only scraper. Serves the assets in ../frontend from the same origin.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "scrape": "node scraper/run.js",
    "scrape:dry": "node scraper/run.js --dry-run",
    "scrape:report": "node scraper/run.js --report-only",
    "verify:sources": "node scraper/verify-sources.js",
    "test": "node scripts/test-extract.js",
    "test:email": "node scripts/test-email.js",
    "check:matching": "node scripts/check-matching.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "import:catalog": "node scripts/import-catalog.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:all": "npm test && npm run check:matching && npm run test:e2e",
    "setup": "npm run migrate && npm run import:catalog",
    "check:links": "node scripts/check-links.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  }
}
