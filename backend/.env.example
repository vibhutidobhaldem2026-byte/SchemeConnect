# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------- database ---
# Required. Every account, consent record, batch and scheme lives here.
# The server refuses to start without it rather than silently falling back to
# local storage that a deploy would wipe.
#
#   local:     postgres://localhost:5432/schemeconnect
#   Supabase:  postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#   Neon:      postgres://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/schemeconnect
#
# TLS is on for any non-local host.
#
# Supabase issues database certificates from its own CA, so the default trust
# store rejects them. Download the certificate from Project Settings → Database
# → SSL Configuration and point PGSSL_CA_FILE at it — the chain is then verified
# properly, hostname included.
#   PGSSL_CA_FILE=certs/prod-ca-2021.crt
#
# PGSSL_NO_VERIFY=true encrypts without verifying. A stopgap only; the server
# warns on every boot while it is set. PGSSL=disable turns TLS off entirely.
DATABASE_URL=postgres://localhost:5432/schemeconnect

# After setting this, create the schema and load the catalogue:
#   npm run migrate
#   npm run import:catalog

# ---------------------------------------------------------------- secrets ---
# Signs CSRF tokens. At least 32 characters. The server refuses to start in
# production without one — two instances with different secrets would reject
# each other's forms.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated addresses that may open /ops. This is the bootstrap route in:
# a fresh deployment has no ops account yet. Beyond this, any account whose
# role is 'ops' qualifies.
OPS_EMAILS=

# ------------------------------------------------------------------ email ---
# Two transports. SMTP wins when both are set.
#
# SMTP is the one that works WITHOUT owning a domain. Resend — like every
# reputable API provider — only delivers to arbitrary recipients from a domain
# you have verified with DNS records; without one it can reach only the account
# owner's own address. Sending through a provider's own SMTP sidesteps that:
# they sign the message as themselves, so there is nothing for us to publish.
#
# Gmail, using a personal account (500 recipients/day):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below, without the spaces Google displays.
# Your ordinary Google password will NOT work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Most providers refuse to send as anyone else.
SMTP_FROM=


# Resend (https://resend.com) — delivers email OTP codes.
# Create a key at https://resend.com/api-keys. A "Sending access" key is enough.
RESEND_API_KEY=

# Sender address, on a domain you have VERIFIED at https://resend.com/domains.
# Adding a domain is not enough — Resend rejects sends from it until its DNS
# records are added and verification passes.
RESEND_FROM=SchemeConnect <no-reply@yourdomain.com>

# Where replies to transactional mail should go.
RESEND_REPLY_TO=support@yourdomain.com

# Used only if RESEND_FROM's domain is not verified yet, so sign-in keeps
# working during DNS propagation. Resend sandbox limits apply while it is in
# use (delivery only to the Resend account owner's own address).
RESEND_FROM_FALLBACK=SchemeConnect <onboarding@resend.dev>

# Show the OTP on screen even when it was emailed successfully.
# Handy while testing; set to false before any real pilot. While this is on,
# the plaintext code is stored alongside its hash so the screen can print it.
SHOW_DEV_OTP=false

# Ping the database every N minutes so a serverless compute never suspends.
# Leave blank. Neon suspends an idle compute after 5 minutes on every plan, and
# waking it costs one slow query rather than an outage. Pinging round the clock
# burns roughly 730 CU-hours a month, against the 100 a free project gets — it
# would exhaust the allowance in about four days. On a paid plan, disable
# scale-to-zero in the Neon console instead of setting this.
KEEPWARM_MINUTES=

# ----------------------------------------------------------------- server ---
PORT=3000

# Bind address. 0.0.0.0 makes the site reachable from other devices on the
# same network (e.g. a phone). Set to 127.0.0.1 to keep it local-only.
HOST=0.0.0.0

# Set to "production" to require SESSION_SECRET, mark cookies Secure, and send
# HSTS. Do this behind TLS only — Secure cookies are dropped over plain HTTP.
NODE_ENV=development
